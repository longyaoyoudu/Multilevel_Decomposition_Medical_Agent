# ============================================================
# QASystemOnMedicalKG 项目配置文件
# 请将此文件复制为 .env 并填入实际配置值
# ============================================================

# ============================================================
# Neo4j 数据库配置
# ============================================================
# Neo4j 连接地址（Bolt协议）
NEO4J_URI=bolt://localhost:7687

# Neo4j 用户名
NEO4J_USER=neo4j

# Neo4j 密码（请修改为实际密码）
NEO4J_PASSWORD=978626572

# ============================================================
# LLM 中间服务配置
# ============================================================
# LLM 服务地址（Flask中间层服务）
LLM_SERVICE_URL=http://127.0.0.1:3001/generate

# Flask 服务端口
FLASK_PORT=3001

# ============================================================
# MiniMax API 配置
# 文档: https://platform.minimaxi.com/document/
# ============================================================
# MiniMax API Key（必填）
MINIMAX_API_KEY=

# MiniMax Group ID（可选，部分API需要）
MINIMAX_GROUP_ID=

# MiniMax API 端点
MINIMAX_API_URL=https://api.minimax.chat/v1/text/chatcompletion_v2

# MiniMax 模型名称
# 可选: abab6.5s-chat (MiniMax-01), abab6.5g-chat (高性能版), abab5.5s-chat (MiniMax-02)
MINIMAX_MODEL_NAME=abab6.5s-chat

# ============================================================
# SiliconFlow（硅基流动）API 配置
# 文档: https://docs.siliconflow.cn/
# ============================================================
# SiliconFlow API Key（必填）
SILICONFLOW_API_KEY=

# SiliconFlow API 端点
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions

# SiliconFlow 模型名称
# 可选: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct 等
SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-V3

# ============================================================
# Ollama 本地模型配置
# 文档: https://ollama.com/
# ============================================================
# Ollama API 地址
OLLAMA_API_URL=http://localhost:11434/api/generate

# Ollama 模型名称
# 可选: qwen3:0.6b, llama3.2:3b, mistral 等
OLLAMA_MODEL_NAME=qwen3:0.6b

# ============================================================
# 生成参数配置
# ============================================================
# 最大生成长度
MAX_TOKENS=2048

# 温度参数（0.0-1.0，越低越确定）
TEMPERATURE=0.7

# Top-P 采样参数
TOP_P=0.9

# Top-K 采样参数
TOP_K=40

# 重复惩罚参数
REPETITION_PENALTY=1.1

# ============================================================
# Web 应用配置
# ============================================================
# Gradio Web 服务端口
GRADIO_PORT=7860

# Gradio 服务地址
GRADIO_HOST=127.0.0.1
